{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-underscore-dangle": "off",
    "no-undef": "error"
  }
}
