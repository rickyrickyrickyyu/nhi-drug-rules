{"inn":"TAFLUPROST","dosing":{},"dose_tfda":[{"text":"建議治療方式為每日1次，於患眼結脹囊中使用1 滴點眼液。\r\n\r\n若忘記某次劑量，應依計畫於下次給藥時間繼續治療。患眼每日劑量不得超過1滴。\r\n複方泰福羅坦(不含防腐劑)眼藥水為單一劑量包裝之無防腐劑滅菌溶液。僅供單次使用，每支包裝足夠用於治療雙倒眼球。應在使用後立即丟棄任何未使用的溶液。","licences":["衛部藥輸字第026770號"],"brands":["複方泰福羅坦(單支裝)眼藥水"],"adjust":[],"n_products":1}],"indications":{"OPH":[{"text":"隅角開放性青光眼及高眼壓症。","n":3,"state":"active"},{"text":"使用於對乙型阻斷劑或前列腺素衍生物類局部單一藥物治療反應不佳，而需要使用複方藥物與無防腐劑點眼液的隅角開放性青光眼或高眼壓成人病患，以降低眼內壓(IOP)","n":1,"state":"active"}]},"items":[{"code":"B025377414","name_en":"Taflotan ophthalmic solution","name_zh":"泰福羅坦眼藥水","brand_stem_en":"Taflotan Ophthalmic","brand_stem_zh":"泰福羅坦","form":"點眼液劑","route":"OPH","atc":"S01EE05","drug_class":"研發廠","is_originator":true,"status":"active","price":0.0,"price_next":null,"price_next_from":null,"vendor":"台灣參天製藥股份有限公司","sections":[],"licence_id":"02025377","licence_no":"衛署藥輸字第025377號","licence_state":"active","indication":"隅角開放性青光眼及高眼壓症。","has_insert":true,"name_zh_repaired":false,"zh_mojibake":false,"inn_keys":["TAFLUPROST"]},{"code":"BC25377414","name_en":"Taflotan ophthalmic solution","name_zh":"泰福羅坦眼藥水","brand_stem_en":"Taflotan Ophthalmic","brand_stem_zh":"泰福羅坦","form":"點眼液劑","route":"OPH","atc":"S01EE05","drug_class":"研發廠","is_originator":true,"status":"active","price":212.0,"price_next":null,"price_next_from":null,"vendor":"台灣參天製藥股份有限公司","sections":[],"licence_id":"02025377","licence_no":"衛署藥輸字第025377號","licence_state":"active","indication":"隅角開放性青光眼及高眼壓症。","has_insert":true,"name_zh_repaired":false,"zh_mojibake":false,"inn_keys":["TAFLUPROST"]},{"code":"BC26615405","name_en":"TAFLOTAN-S ophthalmic solution","name_zh":"泰福羅坦(單支裝)眼藥水0.0015％","brand_stem_en":"Taflotan-S Ophthalmic","brand_stem_zh":"泰福羅坦","form":"點眼液劑","route":"OPH","atc":"S01EE05","drug_class":"研發廠","is_originator":true,"status":"active","price":12.0,"price_next":null,"price_next_from":null,"vendor":"台灣參天製藥股份有限公司","sections":[],"licence_id":"52026615","licence_no":"衛部藥輸字第026615號","licence_state":"active","indication":